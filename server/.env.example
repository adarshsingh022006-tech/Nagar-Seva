# Copy this file to ".env" in the same folder and fill in your own values.
# Never commit the real ".env" file to Git.

# MongoDB connection string.
# Local MongoDB (default install):
MONGO_URI=mongodb://127.0.0.1:27017/nagar_seva

# OR MongoDB Atlas (free cloud cluster) — looks like:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nagar_seva?retryWrites=true&w=majority

# Port the Express server runs on
PORT=5000

# Secret used to sign login tokens (JWT). Use any long random string.
JWT_SECRET=change_this_to_a_long_random_secret_string

# How long a login session lasts
JWT_EXPIRES_IN=8h

# Allowed frontend origin(s) for CORS in production (comma-separated, optional)
# CLIENT_ORIGIN=https://nagar-seva.vercel.app,http://localhost:5173

# Environment
# NODE_ENV=production

